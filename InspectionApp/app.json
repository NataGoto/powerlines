{
  "expo": {
    "name": "InspectionApp",
    "slug": "inspection-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera for photo documentation",
        "NSMicrophoneUsageDescription": "This app needs access to microphone for audio comments",
        "NSLocationWhenInUseUsageDescription": "This app needs location for geotagging photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_MEDIA_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.inspection.app"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow InspectionApp to access your camera for documentation"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow InspectionApp to save photos",
          "savePhotosPermission": "Allow InspectionApp to save photos"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow InspectionApp to use location for geotagging"
        }
      ]
    ]
  }
}
